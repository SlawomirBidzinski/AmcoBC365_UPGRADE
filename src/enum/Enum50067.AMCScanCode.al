enum 50067 "AMC Scan Code"
{
    Extensible = true;
    
    value(0; " ")
    {
        Caption = ' ';
    }
    value(1; EAN)
    {
        Caption = 'EAN';
    }
    value(2; Serial)
    {
        Caption = 'Serial';
    }
    value(3; Lot)
    {
        Caption = 'Lot';
    }
    value(4; "EAN+Serial")
    {
        Caption = 'EAN+Serial';
    }
    value(5; "EAN+Lot")
    {
        Caption = 'EAN+Lot';
    }
}
